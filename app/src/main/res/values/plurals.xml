<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Page count -->
    <plurals name="page_count">
        <item quantity="one">%1$d page</item>
        <item quantity="other">%1$d pages</item>
    </plurals>

    <!-- Image saved -->
    <plurals name="images_saved">
        <item quantity="one">Saved %1$d image to gallery</item>
        <item quantity="other">Saved %1$d images to gallery</item>
    </plurals>

    <!-- Files -->
    <plurals name="files_count">
        <item quantity="one">%1$d file</item>
        <item quantity="other">%1$d files</item>
    </plurals>

    <!-- Words -->
    <plurals name="words_count">
        <item quantity="one">%1$d word</item>
        <item quantity="other">%1$d words</item>
    </plurals>

    <!-- Characters -->
    <plurals name="characters_count">
        <item quantity="one">%1$d character</item>
        <item quantity="other">%1$d characters</item>
    </plurals>

    <!-- Sources searched -->
    <plurals name="sources_searched">
        <item quantity="one">Searched %1$d source</item>
        <item quantity="other">Searched %1$d sources</item>
    </plurals>

    <!-- Seconds remaining -->
    <plurals name="seconds_remaining">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>

</resources>